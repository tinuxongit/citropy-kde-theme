[Icon Theme]
Name=Citropy
Comment=Folders, file types and devices drawn in one smooth style, Breeze Dark for the rest
Inherits=breeze-dark
Directories=places,mimetypes,devices

[places]
Size=64
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[mimetypes]
Size=64
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable

[devices]
Size=64
MinSize=8
MaxSize=512
Context=Devices
Type=Scalable
